# Copy to .env.local and fill in. Never commit .env.local.
# Full walkthrough: docs/DEPLOY.md. On macOS, ./scripts/pull-env.sh fills in the
# Supabase lines for you.

# --- Supabase (required) --------------------------------------------------------
# Project settings -> API. The URL and publishable key are public by design:
# row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SECRET. Server only. Bypasses row-level security, so every query in
# src/server/* scopes by user_id.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Site (optional) -----------------------------------------------------------
# Public URL used in auth email links. Defaults to the Vercel production URL,
# then http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-app.example.com
# Shown on /terms as the contact address.
# CONTACT_EMAIL=you@example.com

# --- Google Calendar (optional) -------------------------------------------------
# OAuth web client from Google Cloud console (docs/DEPLOY.md, section 3).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SECRET. Encrypts Google refresh tokens and reminder relay keys at rest.
# Generate with: openssl rand -base64 32   (changing it disconnects both)
# GOOGLE_TOKEN_KEY=

# --- Reminder relay fallback (optional) ----------------------------------------
# Most people set their own relay in Settings -> Reminders instead. These serve
# only the OWNER_EMAIL account.
# OWNER_EMAIL=you@example.com
# KIWI_WEBHOOK_URL=https://api2.cursor.sh/automations/webhook/<routine-id>
# KIWI_WEBHOOK_TOKEN=crsr_...

# --- Reminder tick (optional) --------------------------------------------------
# pg_cron calls /api/cron/tick with a secret generated inside Postgres (Vault),
# so you normally never set this. Set it only to call the tick from somewhere
# else (another scheduler, or by hand with Authorization: Bearer <value>).
# CRON_SECRET=
